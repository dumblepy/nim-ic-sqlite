+#[derive(CandidType, Deserialize)]
+pub struct BenchHostStatsReport {
+    pub raw_stable_pages: u64,
+    pub raw_stable_bytes: u64,
+}
+
+#[query]
+fn bench_host_stats() -> Result<BenchHostStatsReport, String> {
+    let raw_stable_pages = ic0::stable64_size();
+    Ok(BenchHostStatsReport {
+        raw_stable_pages,
+        raw_stable_bytes: raw_stable_pages
+            .checked_mul(65_536)
+            .ok_or_else(|| "raw stable byte size overflow".to_string())?,
+    })
+}
